    {
      "id": 33,
      "type": "stat",
      "title": "Bytes per staged row",
      "description": "Average storage cost of one staged row (staging size / staging rows). Useful to estimate how big the warehouse gets if the data grows.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 20,
        "y": 14,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "staging_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT captured_at AS \"time\", sum(size_mb)*1048576.0/NULLIF(sum(row_count),0) AS v FROM storage_stats WHERE layer='staging' AND object_name LIKE 'stg_%' AND $__timeFilter(captured_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "-",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8B5CF6"
          }
        },
        "overrides": []
