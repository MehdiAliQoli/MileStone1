          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE object_name WHEN 'stg_master' THEN '01 master data' WHEN 'stg_sales' THEN '05 pharmacy sales' WHEN 'stg_hospital_demand' THEN '06 hospital demand' END AS source, row_count FROM v_storage_latest WHERE object_name IN ('stg_master','stg_sales','stg_hospital_demand') AND object_name IN ($object)"
