      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mart fact rows",
      "description": "Rows in the star-schema fact tables (sales + hospital demand) in the DuckDB mart. Sparkline = growth between snapshots.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "staging_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT captured_at AS \"time\", sum(row_count) AS v FROM storage_stats WHERE object_name LIKE 'fact_%' AND $__timeFilter(captured_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "-",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2563EB"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "text": {
          "titleSize": 13,
          "valueSize": 32
        }
      }
    },
