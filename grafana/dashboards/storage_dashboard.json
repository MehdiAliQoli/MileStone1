    {
      "id": 6,
      "type": "stat",
      "title": "Date coverage",
      "description": "Days between the earliest and latest date in the fact tables. Checks that the 2023-2025 range (plus generated data) is fully represented.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "staging_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT captured_at AS \"time\", (max(max_date)-min(min_date)) AS v FROM storage_stats WHERE min_date IS NOT NULL AND $__timeFilter(captured_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: days",
          "noValue": "-",
          "decimals": 0,
          "color": {
