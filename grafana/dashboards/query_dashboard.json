          "rawQuery": true,
          "rawSql": "SELECT executed_at AS \"time\", avg(duration_ms) OVER w AS v FROM query_log WHERE $__timeFilter(executed_at) AND query_name IN ($qname) AND variant IN ($variant) AND status IN ($qstatus) WINDOW w AS (ORDER BY executed_at) ORDER BY 1"
