    {
      "id": 8,
      "type": "barchart",
      "title": "Median time: baseline vs indexed vs optimized",
      "description": "Median execution time per query for each optimization step. Shorter bars after indexing / partitioning / summary tables prove the optimization worked. Ignores the Variant filter.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "staging_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT query_name, percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) FILTER (WHERE variant='baseline') AS baseline_ms, percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) FILTER (WHERE variant='indexed') AS indexed_ms, percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) FILTER (WHERE variant='optimized') AS optimized_ms FROM query_log WHERE $__timeFilter(executed_at) AND query_name IN ($qname) AND status <> 'failed' AND variant IN ('baseline','indexed','optimized') GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "baseline_ms"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#EF4444"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "indexed_ms"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F59E0B"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "optimized_ms"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#22C55E"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "query_name",
        "orientation": "vertical",
        "showValue": "auto",
        "barWidth": 0.8,
        "xTickLabelRotation": 0,
        "stacking": "none",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
