{
  "id": null,
  "uid": "query-performance",
  "title": "Query Performance Monitoring",
  "description": "Speed and reliability of the analytical queries. Hover the (i) icon on any card to see what it measures.",
  "tags": [
    "pharma"
  ],
  "timezone": "Asia/Karachi",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 20,
        "h": 2
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"font-size:14px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;opacity:.9;border-bottom:3px solid #F59E0B;padding-bottom:4px\">Headline KPIs</div>"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Query error rate",
      "description": "Failed queries / all queries x 100 (syntax errors, missing columns, timeouts). Green under 1 %, orange up to 5 %, red above.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "staging_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT executed_at AS \"time\", 100.0*sum((status='failed')::int) OVER w/count(*) OVER w AS v FROM query_log WHERE $__timeFilter(executed_at) AND query_name IN ($qname) AND variant IN ($variant) AND status IN ($qstatus) WINDOW w AS (ORDER BY executed_at) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "-",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "text": {
          "titleSize": 13,
          "valueSize": 32
        }
      }
    },
