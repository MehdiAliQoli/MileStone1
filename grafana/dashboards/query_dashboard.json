            "uid": "staging_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(executed_at,$__interval), count(*) FILTER (WHERE status <> 'failed') AS ok, count(*) FILTER (WHERE status = 'failed') AS failed FROM query_log WHERE $__timeFilter(executed_at) AND query_name IN ($qname) AND variant IN ($variant) AND status IN ($qstatus) GROUP BY 1 ORDER BY 1"
        }
