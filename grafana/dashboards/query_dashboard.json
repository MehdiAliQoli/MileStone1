          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT executed_at AS executed_at, query_name, variant, status, left(error_message, 100) AS error FROM query_log WHERE $__timeFilter(executed_at) AND query_name IN ($qname) AND variant IN ($variant) AND status IN ($qstatus) AND status = 'failed' ORDER BY executed_at DESC LIMIT 20"
