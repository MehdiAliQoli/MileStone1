        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p95 query time",
      "description": "95 % of queries finish faster than this value: it shows the slow tail that an average hides.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "staging_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) AS v FROM query_log WHERE $__timeFilter(executed_at) AND query_name IN ($qname) AND variant IN ($variant) AND status IN ($qstatus) "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "-",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#D97706"
