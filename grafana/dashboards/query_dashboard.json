    {
      "id": 4,
      "type": "stat",
      "title": "Avg query time",
      "description": "Average execution time of a query in milliseconds. Lower is better.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 8,
        "y": 2,
        "w": 4,
