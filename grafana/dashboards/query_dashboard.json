    {
      "id": 11,
      "type": "timeseries",
      "title": "Queries over time",
      "description": "Successful (blue) and failed (red) queries per time bucket.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
