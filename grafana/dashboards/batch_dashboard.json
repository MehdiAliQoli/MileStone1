    {
      "id": 14,
      "type": "table",
      "title": "Latest batches",
      "description": "The 50 most recent load attempts with their result. Failed rows show the start of the error message.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
