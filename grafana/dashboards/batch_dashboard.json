    {
      "id": 2,
      "type": "stat",
      "title": "Batch success rate",
      "description": "Share of load batches that finished without an error: successful batches / all batches x 100. Green = healthy pipeline.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "staging_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ended_at AS \"time\", 100.0*sum((status='success')::int) OVER w/count(*) OVER w AS v FROM load_log WHERE $__timeFilter(ended_at) AND COALESCE(target_table,'(none)') IN ($tbl) AND status IN ($status) WINDOW w AS (ORDER BY ended_at, load_id) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "-",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#16A34A"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "text": {
          "titleSize": 13,
          "valueSize": 32
        }
      }
    },
