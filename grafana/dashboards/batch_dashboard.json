          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ended_at AS loaded_at, source_file, target_table, status, rows_read, rows_loaded, rows_rejected, duration_sec, left(error_message, 80) AS error FROM load_log WHERE $__timeFilter(ended_at) AND COALESCE(target_table,'(none)') IN ($tbl) AND status IN ($status) ORDER BY ended_at DESC LIMIT 50"
        }
